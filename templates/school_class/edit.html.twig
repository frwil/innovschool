{% extends 'base.up.html.twig' %}

{% block title %}Modifier la classe
{% endblock %}

{% block body %}
	<div class="container mt-4">
		<div class="three">
			<h1>Modifier la classe</h1>
		</div>
		<div class="row">
			<div class="col-md-4 border rounded p-3">
				<form method="post" action="{{ path('app_school_class_edit', {'id': class.id}) }}" id="edit-class-form">
					<input type="hidden" name="_token" value="{{ csrf_token('edit' ~ class.id) }}">
					<div class="mb-3">
						<label for="name" class="form-label">Nom</label>
						<input type="text" id="name" name="name" class="form-control" value="{{ class.classOccurence.name }}" required>
					</div>
					<div class="mb-3">
						<label for="slug" class="form-label">Slug</label>
						<input type="text" id="slug" name="slug" class="form-control" value="{{ class.classOccurence.slug }}" readonly>
					</div>
					<div class="mb-3">
						<label for="class-master" class="form-label">Professeur principal</label>
						<select id="class-master" name="classMaster" class="form-select select2">
							<option value="">Sélectionner un professeur</option>
							{% for teacher in teachers %}
								<option value="{{ teacher.id }}" {% if class.classMaster and class.classMaster.id == teacher.id %} selected {% endif %}>
									{{ teacher.fullName }}
								</option>
							{% endfor %}
						</select>
					</div>
					<div class="mb-3">
						<label class="form-label">Classes suivantes (promotion)</label>
						<div class="border rounded p-3" style="max-height: 250px; overflow-y: auto;">
							{% for occurence in occurences %}
								{% if occurence.id != class.classOccurence.id %}
									<div class="form-check">
										<input type="checkbox" class="form-check-input" id="next-{{ occurence.id }}"
											   name="next_occurences[]" value="{{ occurence.id }}"
											   {% if classConfig and occurence.id in classConfig.nextOccurences|map(o => o.id) %} checked {% endif %}>
										<label class="form-check-label" for="next-{{ occurence.id }}">{{ occurence.name }}</label>
									</div>
								{% endif %}
							{% endfor %}
						</div>
						<small class="form-text text-muted">
							Occurrences de classes dans lesquelles les élèves promus de cette classe peuvent être
							inscrits — configuration propre à votre établissement.
						</small>
					</div>
					<div class="mb-3">
						<div class="form-check">
							<input type="checkbox" class="form-check-input" id="is-final-level"
								   name="is_final_level" value="1"
								   {% if classConfig and classConfig.isFinalLevel %} checked {% endif %}>
							<label class="form-check-label" for="is-final-level">Niveau final (classe terminale)</label>
						</div>
						<small class="form-text text-muted">
							Les élèves promus quittent l'établissement : aucune classe suivante n'est requise.
						</small>
					</div>
					<button type="submit" class="btn btn-primary">Enregistrer</button>
					<a href="{{ path('app_school_class_show', {'id': section.id}) }}" class="btn btn-secondary">Annuler</a>
				</form>
			</div>
		</div>
	</div>
{% endblock %}
