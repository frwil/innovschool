{{ form_start(form, {'attr': {'class': 'new-added-form', 'id': form.vars.id}}) }}
{{ form_errors(form) }}
<div class="row">
    <div class="col-12-xxxl col-xl-4 col-sm-6 col-12 form-group">
        {{ form_label(form.name) }}
        {{ form_widget(form.name) }}
        {{ form_errors(form.name) }}
        {% if form.name.vars.attr.readonly|default(false) %}
        <small class="form-text text-muted">Le nom est déterminé automatiquement : seule la successeure directe de la dernière période est acceptée.</small>
        {% elseif form.name.vars.disabled %}
        <small class="form-text text-muted">Le nom de la période est verrouillé après création.</small>
        {% endif %}
    </div>

    <div class="col-12 form-group mg-t-8">
        <button type="submit" class="btn-fill-lg btn-gradient-yellow btn-hover-bluedark" data-submit-label="{{ button_label|default('Enregistrer') }}">{{ button_label|default('Enregistrer') }}</button>
        <!-- <button type="reset" class="btn-fill-lg bg-blue-dark btn-hover-yellow">Reset</button> -->
    </div>
</div>
{{ form_end(form) }}

<script>
(function () {
    var form = document.getElementById('{{ form.vars.id }}');
    if (!form) {
        return;
    }

    var btn = form.querySelector('button[type="submit"]');
    if (!btn) {
        return;
    }

    function disableButton() {
        btn.dataset.submitting = '1';
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> ' + btn.dataset.submitLabel + '…';
    }

    // Réactivation en cas d'erreur uniquement : remet le libellé d'origine
    function enableButton() {
        btn.dataset.submitting = '';
        btn.disabled = false;
        btn.innerHTML = btn.dataset.submitLabel;
    }

    form.addEventListener('submit', function (event) {
        if (btn.dataset.submitting) {
            // Déjà en cours : bloque les soumissions multiples (double-clic, touche Entrée, soumission programmatique)
            event.preventDefault();
            return;
        }
        disableButton();

        // Filet de sécurité : si la page est toujours affichée après ce délai,
        // la soumission n'a pas abouti (erreur réseau, serveur muet…) : on
        // réactive le bouton pour permettre une nouvelle tentative. En cas de
        // succès, la navigation a déjà vidé la page et ce timer ne s'exécute pas.
        setTimeout(function () {
            if (btn.dataset.submitting) {
                enableButton();
            }
        }, 20000);
    });

    // Retour/avance du navigateur : la page restaurée depuis le cache fige
    // l'état « désactivé + spinner », on le rétablit.
    window.addEventListener('pageshow', function (event) {
        if (event.persisted && btn.dataset.submitting) {
            enableButton();
        }
    });
})();
</script>