{% extends 'base.html.twig' %}

{% block title %}SchoolPeriod index{% endblock %}

{% block body %}
<twig:Breadcrumbs label="Gérer les périodes" />

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="close" data-bs-dismiss="alert" aria-label="Fermer">&times;</button>
        </div>
    {% endfor %}
{% endfor %}

<twig:Layout:ListAdd>
    <twig:block name="table">
        <table class="table display data-table text-nowrap">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Période précédente</th>
                    <th>Actuelle</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for school_period in school_periods %}
                <tr>
                    <td>
                        <a href="{{ path('app_school_period_edit', {'id': school_period.id}) }}">{{ school_period.name }}</a>
                    </td>
                    <td>{{ school_period.previousPeriod ? school_period.previousPeriod.name : '—' }}</td>
                    <td>
                        {% if school_period.enabled %}
                        <span class="badge badge-success">Oui</span>
                        {% else %}
                        <span class="badge badge-danger">Non</span>
                        <a class="btn btn-info" href="{{path('app_school_period_default', {id: school_period.id})}}">Définir par defaut</a>
                        {% endif %}
                    </td>
                    <td>
                        {# Seule la dernière période peut être supprimée : la vérification
                           des données liées se fait sur la page dédiée. #}
                        {% if latest is not null and school_period.id == latest.id %}
                        <a class="btn btn-sm btn-danger" href="{{ path('app_school_period_delete_check', {'id': school_period.id}) }}">Supprimer</a>
                        {% endif %}
                    </td>
                </tr>

                {% endfor %}
            </tbody>
        </table>
    </twig:block>
    <twig:block name="form">
        {% if previous_period %}
        <p class="text-muted">La nouvelle période sera automatiquement liée à la période précédente : <strong>{{ previous_period.name }}</strong>.</p>
        {% else %}
        <p class="text-muted">Aucune période n'existe encore : cette première période ne sera liée à aucune précédente.</p>
        {% endif %}
        {{ include('school_period/_form.html.twig') }}
    </twig:block>
</twig:Layout:ListAdd>


{% endblock %}
