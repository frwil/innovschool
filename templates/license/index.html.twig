{% extends 'base.html.twig' %}

{% block title %}Gestion de la licence{% endblock %}

{% block body %}
<twig:Breadcrumbs label="Gestion de la licence" />

{% if not license %}
    <div class="alert alert-warning">
        <i class="ti ti-alert-circle me-2"></i>
        Aucune licence active trouvée pour cet établissement.
    </div>
{% else %}

{# ── Statut général ── #}
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card h-100 border-{{ isExpired ? 'danger' : (remainingDays <= 15 ? 'warning' : 'success') }}">
            <div class="card-body text-center">
                <div class="mb-2">
                    {% if isExpired %}
                        <span class="badge bg-danger fs-6 px-3 py-2"><i class="ti ti-x me-1"></i>Expirée</span>
                    {% elseif remainingDays <= 15 %}
                        <span class="badge bg-warning text-dark fs-6 px-3 py-2"><i class="ti ti-alert-triangle me-1"></i>Expire bientôt</span>
                    {% else %}
                        <span class="badge bg-success fs-6 px-3 py-2"><i class="ti ti-check me-1"></i>Active</span>
                    {% endif %}
                </div>
                <div class="display-4 fw-bold {{ isExpired ? 'text-danger' : (remainingDays <= 15 ? 'text-warning' : 'text-success') }}">
                    {{ remainingDays }}
                </div>
                <div class="text-muted">jours restants</div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="text-muted mb-3"><i class="ti ti-license me-1"></i>Détails de la licence</h6>
                <table class="table table-sm mb-0">
                    <tr>
                        <td class="text-muted">Type</td>
                        <td>
                            {% if license.licenseType == 'pro' %}
                                <span class="badge bg-primary">Pro</span>
                            {% else %}
                                <span class="badge bg-secondary">Essai</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">Début</td>
                        <td>{{ license.licenceStartAt|date('d/m/Y') }}</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Durée</td>
                        <td>{{ license.licenceDuration }} jours</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Expiration</td>
                        <td class="{{ isExpired ? 'text-danger fw-bold' : '' }}">
                            {{ endDate ? endDate|date('d/m/Y') : '—' }}
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">Montant</td>
                        <td>{{ license.licenceAmount|number_format(0, ',', ' ') }} FCFA</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="text-muted mb-3"><i class="ti ti-refresh me-1"></i>Renouveler la licence</h6>
                <p class="text-muted small">Entrez le token fourni par votre administrateur système pour prolonger la licence.</p>
                <form method="POST" action="{{ path('app_renew_license') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('renew_license') }}">
                    <div class="mb-2">
                        <input type="text" name="license_token" class="form-control form-control-sm font-monospace"
                               placeholder="Token de renouvellement" required
                               {% if not isExpired %}
                               title="Date de référence : {{ license.licenceStartAt|date('Y-m-d') }}"
                               {% endif %}>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="ti ti-player-play me-1"></i>Valider le token
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

{# ── Enregistrer un paiement ── #}
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0"><i class="ti ti-cash me-2"></i>Enregistrer un paiement</h5>
    </div>
    <div class="card-body">
        <form method="POST" action="{{ path('app_licence_add_payment') }}" class="row g-3 align-items-end">
            <input type="hidden" name="_token" value="{{ csrf_token('add_payment') }}">
            <div class="col-md-3">
                <label class="form-label">Montant (FCFA) <span class="text-danger">*</span></label>
                <input type="number" name="amount" class="form-control" min="1" step="500" required placeholder="50000">
            </div>
            <div class="col-md-3">
                <label class="form-label">Mode de paiement <span class="text-danger">*</span></label>
                <select name="payment_method" class="form-select" required>
                    <option value="cash">Espèces</option>
                    <option value="mobile_money">Mobile Money</option>
                    <option value="bank_transfer">Virement bancaire</option>
                    <option value="cheque">Chèque</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Date du paiement</label>
                <input type="date" name="payment_date" class="form-control" value="{{ 'now'|date('Y-m-d') }}">
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-success w-100">
                    <i class="ti ti-plus me-1"></i>Enregistrer
                </button>
            </div>
        </form>
    </div>
</div>

{# ── Historique des paiements ── #}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="ti ti-history me-2"></i>Historique des paiements</h5>
        <span class="badge bg-secondary">{{ payments|length }} paiement(s)</span>
    </div>
    {% if payments is empty %}
        <div class="card-body text-muted fst-italic text-center py-4">
            Aucun paiement enregistré pour cette licence.
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Montant</th>
                        <th>Mode</th>
                    </tr>
                </thead>
                <tbody>
                    {% for payment in payments|sort((a, b) => b.datePayment <=> a.datePayment) %}
                    <tr>
                        <td>{{ payment.datePayment|date('d/m/Y') }}</td>
                        <td class="fw-bold">{{ payment.paymentAmount|number_format(0, ',', ' ') }} FCFA</td>
                        <td>
                            {% set methodLabels = {
                                'cash': 'Espèces',
                                'mobile_money': 'Mobile Money',
                                'bank_transfer': 'Virement',
                                'cheque': 'Chèque'
                            } %}
                            {{ methodLabels[payment.paymentMethod] ?? payment.paymentMethod }}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td class="fw-bold">Total</td>
                        <td class="fw-bold">
                            {{ payments|reduce((carry, p) => carry + p.paymentAmount, 0)|number_format(0, ',', ' ') }} FCFA
                        </td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    {% endif %}
</div>

{% endif %}
{% endblock %}
