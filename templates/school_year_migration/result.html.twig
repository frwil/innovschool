{% extends 'base.html.twig' %}

{% block title %}Résultat de la migration{% endblock %}

{% block body %}
<twig:Breadcrumbs label="Résultat de la migration" />

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="close" data-dismiss="alert" aria-label="Fermer">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    {% endfor %}
{% endfor %}

<div class="row">
    <div class="col-md-10 mx-auto">

        <div class="alert alert-success">
            <i class="ti ti-circle-check me-2 fs-5"></i>
            <strong>Migration réussie !</strong>
            La configuration de <strong>{{ sourcePeriod.name }}</strong> a été reconduite vers
            <strong>{{ targetPeriod.name }}</strong>.
        </div>

        {# ── Résumé configuration ── #}
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="ti ti-copy me-2"></i>Configuration reconduite</h5>
            </div>
            <div class="card-body">
                <div class="row text-center g-3">
                    <div class="col">
                        <div class="display-6 fw-bold text-primary">{{ configSummary.subject_groups }}</div>
                        <div class="text-muted">Groupe(s) de matières</div>
                    </div>
                    <div class="col">
                        <div class="display-6 fw-bold text-primary">{{ configSummary.classes }}</div>
                        <div class="text-muted">Classe(s)</div>
                    </div>
                    <div class="col">
                        <div class="display-6 fw-bold text-primary">{{ configSummary.subjects }}</div>
                        <div class="text-muted">Matière(s) / Enseignant(s)</div>
                    </div>
                    <div class="col">
                        <div class="display-6 fw-bold text-primary">{{ configSummary.modules }}</div>
                        <div class="text-muted">Module(s)</div>
                    </div>
                    <div class="col">
                        <div class="display-6 fw-bold text-primary">{{ configSummary.payment_modals }}</div>
                        <div class="text-muted">Modalité(s) de paiement</div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Résumé élèves ── #}
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="ti ti-users me-2"></i>Promotion des élèves</h5>
            </div>
            <div class="card-body">
                <div class="row text-center g-3">
                    <div class="col">
                        <div class="display-6 fw-bold text-success">{{ studentStats.promoted }}</div>
                        <div class="text-muted">Élève(s) promu(s)</div>
                        <div class="text-muted small">Moyenne &ge; {{ passingGrade }}/20</div>
                    </div>
                    <div class="col">
                        <div class="display-6 fw-bold text-warning">{{ studentStats.repeated }}</div>
                        <div class="text-muted">Élève(s) redoublant(s)</div>
                        <div class="text-muted small">Moyenne &lt; {{ passingGrade }}/20</div>
                    </div>
                    <div class="col">
                        <div class="display-6 fw-bold text-secondary">{{ studentStats.skipped }}</div>
                        <div class="text-muted">Non affecté(s)</div>
                        <div class="text-muted small">Sortants ou cible non définie</div>
                    </div>
                </div>
            </div>
        </div>

        {% if (studentStats.existing ?? 0) > 0 %}
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="ti ti-user-check me-2"></i>Déjà inscrit(s)</h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col">
                        <div class="display-6 fw-bold text-info">{{ studentStats.existing }}</div>
                        <div class="text-muted">Élève(s) déjà inscrit(s) dans la classe cible</div>
                        <div class="text-muted small">Aucune inscription en double n'a été créée.</div>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}

        {% set skippedStudents = studentStats.skippedStudents|default([]) %}
        {% if studentStats.skipped > 0 %}
        <div class="alert alert-warning">
            <i class="ti ti-alert-circle me-2"></i>
            <strong>{{ studentStats.skipped }} élève(s)</strong> n'ont pas été affectés : élèves en classe
            terminale d'une chaîne (sortants) ou sans classe cible définie. Vous pouvez les inscrire
            manuellement.
        </div>
        {% if skippedStudents is not empty %}
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="ti ti-list me-2"></i>Élèves non affectés</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Élève</th>
                                <th>Classe source</th>
                                <th class="text-center">Moyenne</th>
                                <th>Raison</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for student in skippedStudents %}
                            <tr>
                                <td>{{ student.name }}</td>
                                <td>{{ student.className }}</td>
                                <td class="text-center">
                                    {% if (student.average ?? null) is not null %}
                                        {{ student.average|number_format(2, ',', ' ') }}/20
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td>{{ student.reason }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        {% endif %}
        {% endif %}

        <div class="d-flex gap-2 flex-wrap">
            <a href="{{ path('app_year_migration_index') }}" class="btn btn-primary">
                <i class="ti ti-arrows-transfer-up me-1"></i>Nouvelle migration
            </a>
            {% if log is defined and log %}
            <a href="{{ path('app_year_migration_manage', {id: log.id}) }}" class="btn btn-warning">
                <i class="ti ti-settings me-1"></i>Gérer cette migration (annuler / corriger)
            </a>
            {% endif %}
            <a href="{{ path('app_school_period_index') }}" class="btn btn-light">
                <i class="ti ti-calendar me-1"></i>Gérer les périodes
            </a>
        </div>

    </div>
</div>
{% endblock %}
