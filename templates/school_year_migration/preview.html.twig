{% extends 'base.html.twig' %}

{% block title %}Prévisualisation de la migration{% endblock %}

{% block body %}
<twig:Breadcrumbs label="Prévisualisation de la migration" />

<form method="POST" action="{{ path('app_year_migration_execute') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('year_migration') }}">
    <input type="hidden" name="source_period" value="{{ sourcePeriod.id }}">
    <input type="hidden" name="target_period" value="{{ targetPeriod.id }}">
    <input type="hidden" name="passing_grade" value="{{ passingGrade }}">
    {% for key, val in options %}
        {% if val %}
            <input type="hidden" name="opt_{{ key }}" value="1">
        {% endif %}
    {% endfor %}

    {# ── Résumé de la configuration ── #}
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="ti ti-settings me-2"></i>Configuration de la migration</h5>
        </div>
        <div class="card-body">
            <div class="row text-center g-3">
                <div class="col">
                    <div class="text-muted small">Période source</div>
                    <div class="fw-bold">{{ sourcePeriod.name }}</div>
                </div>
                <div class="col-auto d-flex align-items-center">
                    <i class="ti ti-arrow-right fs-4 text-primary"></i>
                </div>
                <div class="col">
                    <div class="text-muted small">Période cible</div>
                    <div class="fw-bold text-primary">{{ targetPeriod.name }}</div>
                </div>
                <div class="col">
                    <div class="text-muted small">Note de passage</div>
                    <div class="fw-bold">{{ passingGrade }}/20</div>
                </div>
            </div>
            <hr>
            <div class="d-flex flex-wrap gap-2">
                {% if options.subject_groups %}<span class="badge bg-info">Groupes de matières</span>{% endif %}
                {% if options.classes %}<span class="badge bg-info">Classes</span>{% endif %}
                {% if options.subjects %}<span class="badge bg-info">Matières &amp; enseignants</span>{% endif %}
                {% if options.modules %}<span class="badge bg-info">Modules</span>{% endif %}
                {% if options.payment_modals %}<span class="badge bg-info">Modalités de paiement</span>{% endif %}
            </div>
        </div>
    </div>

    {# ── Par classe : stats + mapping ── #}
    {% if preview is empty %}
        <div class="alert alert-warning">
            <i class="ti ti-alert-circle me-2"></i>
            Aucune classe trouvée pour la période source. Vérifiez que des classes ont été configurées.
        </div>
    {% else %}
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="ti ti-users me-2"></i>
                    Éligibilité des élèves &amp; affectation des classes
                </h5>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Classe source</th>
                            <th class="text-center">Total élèves</th>
                            <th class="text-center text-success">Promus (&ge; {{ passingGrade }})</th>
                            <th class="text-center text-danger">Redoublants (&lt; {{ passingGrade }})</th>
                            <th>Classe cible pour les promus</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in preview %}
                        <tr>
                            <td><strong>{{ row.className }}</strong></td>
                            <td class="text-center">{{ row.total }}</td>
                            <td class="text-center">
                                <span class="badge bg-success fs-6">{{ row.eligible }}</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-danger fs-6">{{ row.nonEligible }}</span>
                            </td>
                            <td>
                                {% if targetClassOptions is empty %}
                                    <span class="text-muted fst-italic">
                                        Aucune classe dans la période cible (la migration de configuration les créera)
                                    </span>
                                    <input type="hidden" name="class_mapping[{{ row.schoolClassPeriod.id }}]" value="">
                                {% else %}
                                    <select name="class_mapping[{{ row.schoolClassPeriod.id }}]" class="form-select form-select-sm">
                                        <option value="">— Non affecté —</option>
                                        {% for targetId, targetName in targetClassOptions %}
                                            <option value="{{ targetId }}">{{ targetName }}</option>
                                        {% endfor %}
                                    </select>
                                {% endif %}
                            </td>
                        </tr>
                        {# Detail par élève (collapsible) #}
                        {% if row.studentStats is not empty %}
                        <tr class="table-secondary">
                            <td colspan="5" class="py-1">
                                <a class="text-decoration-none small" data-bs-toggle="collapse"
                                   href="#students-{{ row.schoolClassPeriod.id }}">
                                    <i class="ti ti-chevron-down me-1"></i>
                                    Voir le détail des {{ row.total }} élèves
                                </a>
                                <div class="collapse mt-2" id="students-{{ row.schoolClassPeriod.id }}">
                                    <table class="table table-sm mb-0">
                                        <thead>
                                            <tr>
                                                <th>Élève</th>
                                                <th class="text-center">Moyenne</th>
                                                <th class="text-center">Statut</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for stat in row.studentStats %}
                                            <tr>
                                                <td>
                                                    {{ stat.student.firstName ?? '' }} {{ stat.student.lastName ?? stat.student.username }}
                                                </td>
                                                <td class="text-center">
                                                    {% if stat.average is not null %}
                                                        <strong class="{{ stat.eligible ? 'text-success' : 'text-danger' }}">
                                                            {{ stat.average|number_format(2, ',') }}/20
                                                        </strong>
                                                    {% else %}
                                                        <span class="text-muted">—</span>
                                                    {% endif %}
                                                </td>
                                                <td class="text-center">
                                                    {% if stat.eligible %}
                                                        <span class="badge bg-success">Promu</span>
                                                    {% else %}
                                                        <span class="badge bg-danger">Redoublant</span>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                        </tr>
                        {% endif %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    <div class="alert alert-warning">
        <i class="ti ti-alert-triangle me-2"></i>
        <strong>Attention :</strong> Cette opération va créer de nouvelles données dans la période cible.
        Elle ne supprime aucune donnée existante. Vérifiez bien les paramètres avant de confirmer.
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">
            <i class="ti ti-player-play me-1"></i>
            Lancer la migration
        </button>
        <a href="{{ path('app_year_migration_index') }}" class="btn btn-light">
            <i class="ti ti-arrow-left me-1"></i>
            Retour
        </a>
    </div>

</form>
{% endblock %}
