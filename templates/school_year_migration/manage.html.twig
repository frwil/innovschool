{% extends 'base.up.html.twig' %}

{% block title %}Gérer la migration{% endblock %}

{% block body %}
<twig:Breadcrumbs label="Gérer la migration" />

<div class="row">
<div class="col-md-10 mx-auto">

    {# ── En-tête ── #}
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="ti ti-arrows-transfer-up me-2"></i>
                Migration : <strong>{{ log.sourcePeriod.name }}</strong>
                → <strong>{{ log.targetPeriod.name }}</strong>
            </h5>
            <span class="badge bg-{{ log.status == 'cancelled' ? 'danger' : (log.status == 'corrected' ? 'warning' : 'success') }} fs-6">
                {{ log.status == 'executed' ? 'Exécutée' : (log.status == 'cancelled' ? 'Annulée' : 'Corrigée') }}
            </span>
        </div>
        <div class="card-body">
            <div class="row g-3 text-center">
                <div class="col-md-3">
                    <div class="text-muted small">Exécutée le</div>
                    <div class="fw-bold">{{ log.executedAt|date('d/m/Y à H:i') }}</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Par</div>
                    <div class="fw-bold">{{ log.executedBy }}</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Note de passage</div>
                    <div class="fw-bold">{{ log.passingGrade }}/20</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Élèves migrés</div>
                    <div class="fw-bold">{{ state.totalStudents }}</div>
                </div>
            </div>
        </div>
    </div>

    {% if log.status != 'executed' %}
    <div class="alert alert-secondary">
        <i class="ti ti-info-circle me-2"></i>
        Cette migration a le statut <strong>{{ log.status }}</strong> — aucune action supplémentaire n'est disponible.
    </div>
    <a href="{{ path('app_year_migration_index') }}" class="btn btn-light">
        <i class="ti ti-arrow-left me-1"></i>Retour
    </a>

    {% elseif state.canCancel %}
    {# ════════════════════════════════════════════════════════════════════════
       MODE ANNULATION COMPLÈTE (0 note saisie)
    ════════════════════════════════════════════════════════════════════════ #}

    <div class="alert alert-success">
        <i class="ti ti-circle-check me-2"></i>
        <strong>Aucune note saisie</strong> pour les {{ state.totalStudents }} élèves migrés.
        Vous pouvez annuler cette migration entièrement.
    </div>

    <div class="card border-danger mb-4">
        <div class="card-header bg-danger text-white">
            <h6 class="mb-0"><i class="ti ti-trash me-2"></i>Annulation complète</h6>
        </div>
        <div class="card-body">
            <p>L'annulation supprimera définitivement tout ce qui a été créé par cette migration :</p>
            <ul class="mb-3">
                <li>{{ log.createdIds.subjectGroups|length }} groupe(s) de matières</li>
                <li>{{ log.createdIds.schoolClassPeriods|length }} classe(s)</li>
                <li>{{ log.createdIds.schoolClassSubjects|length }} affectation(s) matière/enseignant</li>
                <li>{{ log.createdIds.classSubjectModules|length }} module(s) d'évaluation</li>
                <li>{{ log.createdIds.paymentModals|length }} modalité(s) de paiement</li>
                <li>{{ log.createdIds.studentClasses|length }} inscription(s) élève</li>
            </ul>
            <form method="POST" action="{{ path('app_year_migration_cancel', {id: log.id}) }}"
                  onsubmit="return confirm('Confirmer l\'annulation complète ? Cette action est irréversible.')">
                <input type="hidden" name="_token" value="{{ csrf_token('cancel_migration_' ~ log.id) }}">
                <button type="submit" class="btn btn-danger">
                    <i class="ti ti-trash me-1"></i>Confirmer l'annulation
                </button>
                <a href="{{ path('app_year_migration_index') }}" class="btn btn-light ms-2">Annuler</a>
            </form>
        </div>
    </div>

    {# Correction possible aussi même sans notes #}
    <div class="card mb-4">
        <div class="card-header">
            <h6 class="mb-0"><i class="ti ti-edit me-2"></i>Ou corriger la note de passage</h6>
        </div>
        <div class="card-body">
            <p class="text-muted">Si vous souhaitez juste changer la note de passage sans tout supprimer.</p>
            {{ include('school_year_migration/_correction_form.html.twig') }}
        </div>
    </div>

    {% else %}
    {# ════════════════════════════════════════════════════════════════════════
       MODE CORRECTION PARTIELLE (notes déjà saisies)
    ════════════════════════════════════════════════════════════════════════ #}

    <div class="alert alert-warning">
        <i class="ti ti-alert-triangle me-2"></i>
        <strong>{{ state.evaluationCount }} note(s) déjà saisie(s)</strong>
        pour {{ state.lockedIds|length }} élève(s).
        L'annulation complète est <strong>bloquée</strong>.
        Seule la <strong>correction partielle</strong> est disponible.
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-center border-success">
                <div class="card-body">
                    <div class="display-5 fw-bold text-success">{{ state.unlockableIds|length }}</div>
                    <div class="text-muted">élève(s) modifiable(s)</div>
                    <small class="text-muted">Pas de notes saisies</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center border-danger">
                <div class="card-body">
                    <div class="display-5 fw-bold text-danger">{{ state.lockedIds|length }}</div>
                    <div class="text-muted">élève(s) verrouillé(s)</div>
                    <small class="text-muted">Notes déjà saisies — intouchables</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <div class="display-5 fw-bold">{{ state.evaluationCount }}</div>
                    <div class="text-muted">note(s) saisies</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h6 class="mb-0"><i class="ti ti-edit me-2"></i>Correction partielle</h6>
        </div>
        <div class="card-body">
            <p class="text-muted">
                Entrez une nouvelle note de passage pour voir quels élèves (sans notes) changeraient de statut.
            </p>
            {{ include('school_year_migration/_correction_form.html.twig') }}
        </div>
    </div>

    {% endif %}

</div>
</div>
{% endblock %}
