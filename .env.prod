# Environment
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=1f93e258b24a6c32820fbb4e2dd2c7e1
APP_TIMEZONE=Africa/Douala

# Database
DATABASE_URL="mysql://root:root@database:3306/innovsh?serverVersion=8.0.42&charset=utf8mb4&ssl-mode=DISABLED"

# Messenger
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages

# Mailer - À configurer avec un vrai service d'envoi d'emails
MAILER_DSN=smtp://localhost:1025

# Application URLs - À mettre à jour avec les URLs de production
APP_UPDATE_JSON_URL=https://ton-serveur.com/update.json
APP_UPDATE_ZIP_URL=https://ton-serveur.com/core.zip
APP_LICENSE_SECRET=ChangeThisSecretKey!

# Memory Limits
MEMORY_LIMIT=4096M
PHP_MEMORY_LIMIT=4096M
SYMFONY_MEMORY_LIMIT=4096M

# Docker User Configuration
USER_ID=1000
GROUP_ID=1000

# PHP Configuration
PHP_OPCACHE_ENABLE=1
PHP_OPCACHE_MEMORY_CONSUMPTION=256
